{
  "name": "khora-online",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest --run --passWithNoTests",
    "lint": "eslint packages/*/src/**/*.ts",
    "dev:server": "npm run start --workspace=packages/server",
    "dev:client": "npm run dev --workspace=packages/client",
    "reference:search": "tsx packages/server/src/offline-reference-search.ts",
    "reference:session": "tsx packages/server/src/offline-reference-session.ts",
    "reference:validate": "tsx packages/server/src/live-solver-reference-validate.ts --",
    "solver:benchmark": "tsx packages/server/src/live-solver-benchmark.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "fast-check": "^3.22.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
